# Handle line endings automatically for all text files
* text=auto

# Shell scripts must keep LF
gradlew text eol=lf

# Kotlin/Java/TypeScript source files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Windows batch file — keep CRLF
*.bat text eol=crlf

# Binary files — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
